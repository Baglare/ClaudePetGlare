<UserControl x:Class="Petglare.PetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SizeChanged="ViewSizeChanged">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="BubbleRow" Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- One bubble per chat; the most important one sits closest to the mascot. -->
    <StackPanel x:Name="BubbleStack" Grid.Row="0" IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,5,8,-3"
                SizeChanged="StackSizeChanged">
      <StackPanel.RenderTransform>
        <TranslateTransform x:Name="BubbleOffset"/>
      </StackPanel.RenderTransform>
    </StackPanel>

    <Grid x:Name="Mascot" Grid.Row="1" Width="89" Height="91" Margin="0,0,6,4" HorizontalAlignment="Right"
          VerticalAlignment="Bottom" Background="Transparent" ToolTipService.InitialShowDelay="600"
          MouseEnter="MascotHover" MouseLeave="MascotHover">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="MascotScale"/>
      </Grid.LayoutTransform>
      <Grid.RenderTransform>
        <TranslateTransform x:Name="MascotOffset"/>
      </Grid.RenderTransform>
      <Canvas x:Name="MascotCanvas" Width="89" Height="91" Background="Transparent" Cursor="Hand"
              SnapsToDevicePixels="True">
        <Ellipse Width="68" Height="12" Canvas.Left="10" Canvas.Top="78" Fill="#4321263C"/>
        <Path x:Name="Body" Fill="#C9BDFF" Stroke="#2D284C" StrokeThickness="2.5" StrokeLineJoin="Round"/>
        <Path x:Name="Ears" Data="M 16,29 Q 15,18 20,12 L 30,22 Z M 61,22 L 73,12 Q 77,20 73,30 Z"
              Fill="#E995BA"/>
        <Path Data="M 15,55 C 15,40 29,31 44,31 C 61,31 76,41 76,56
                    C 76,69 64,76 44,76 C 26,76 15,69 15,55 Z" Fill="#292641"/>
        <Path Data="M 23,67 Q 45,77 69,66 Q 62,74 45,74 Q 29,74 23,67 Z" Fill="#3E385F"/>
        <Ellipse x:Name="LeftEye" Width="10" Height="15" Canvas.Left="29" Canvas.Top="44" Fill="#A9F4D8"/>
        <Ellipse x:Name="RightEye" Width="10" Height="15" Canvas.Left="53" Canvas.Top="44" Fill="#A9F4D8"/>
        <Path Data="M 41,61 Q 45,66 50,61" Stroke="#F2ECFF" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path x:Name="Cheeks" Data="M 20,59 L 24,59 M 68,59 L 72,59" Stroke="#E995BA"
              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path x:Name="DoneSpark" Visibility="Collapsed" IsHitTestVisible="False"
              Data="M 75,60 Q 76,71 87,72 Q 76,73 75,84 Q 74,74 63,72 Q 74,71 75,60 Z"
              Fill="#A9F4D8" Stroke="#254737" StrokeThickness="1.5" StrokeLineJoin="Round"/>
      </Canvas>
      <Border x:Name="SessionBadge" Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,14"
              MinWidth="20" Height="20" CornerRadius="10" Padding="5,0"
              Background="#292641" BorderBrush="#C9BDFF" BorderThickness="1.5">
        <TextBlock x:Name="SessionCount" Foreground="#F5F1FF" FontFamily="Segoe UI" FontWeight="Bold"
                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel x:Name="ResizeButtons" Orientation="Horizontal" HorizontalAlignment="Center"
                  VerticalAlignment="Top" Margin="0,3,0,0" Visibility="Hidden">
        <StackPanel.Resources>
          <Style TargetType="Button">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
          </Style>
        </StackPanel.Resources>
        <Button Content="−" ToolTip="Küçült" AutomationProperties.Name="Küçült" Click="ShrinkClick"/>
        <Button Content="+" ToolTip="Büyüt" AutomationProperties.Name="Büyüt" Click="EnlargeClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
