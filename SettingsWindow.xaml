<Window x:Class="Petglare.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Petglare"
        Title="Petglare Ayarları" Icon="pack://application:,,,/Assets/Petglare.ico" Width="900" Height="640" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="370"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Live preview: the same view the desktop pet draws with -->
    <Border Grid.Column="0" Margin="20,20,8,16" CornerRadius="16" Background="{StaticResource Surface}"
            Padding="20,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Önizleme" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                     FontWeight="SemiBold"/>
          <TextBlock Text="Uygula’ya basınca masaüstündeki maskot böyle görünür." Foreground="{StaticResource Soft}"
                     TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="3" CornerRadius="10"
                Background="{StaticResource Canvas}" HorizontalAlignment="Left">
          <StackPanel x:Name="PreviewStates" Orientation="Horizontal"/>
        </Border>
        <Border x:Name="Stage" CornerRadius="12" Background="{StaticResource Canvas}" Margin="0,16,0,0"
                ClipToBounds="True">
          <!-- Large sizes are shrunk to fit the stage; never enlarged -->
          <Viewbox StretchDirection="DownOnly" Stretch="Uniform" VerticalAlignment="Bottom" Margin="8,8,8,10">
            <local:PetView x:Name="Preview"/>
          </Viewbox>
        </Border>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,20,8,16" Focusable="False">
      <StackPanel x:Name="Sections" Margin="18,0,18,8"/>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Background="{StaticResource Surface}" Padding="20,12">
      <DockPanel>
        <Button x:Name="DefaultsButton" DockPanel.Dock="Left" Style="{StaticResource Quiet}"
                Content="Varsayılanlara dön" Click="Defaults"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Secondary}" Content="Kapat" Click="CloseClick" IsCancel="True"
                  Margin="0,0,10,0"/>
          <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Uygula" Click="ApplyClick"
                  IsDefault="True" MinWidth="104"/>
        </StackPanel>
        <TextBlock x:Name="Status" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"
                   Foreground="{StaticResource Soft}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
