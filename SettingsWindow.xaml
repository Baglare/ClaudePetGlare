<Window x:Class="Petglare.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Petglare"
        Title="Petglare Ayarları" Width="900" Height="640" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- The pet's own palette: night blue surfaces, lavender for choice, mint for done. -->
    <SolidColorBrush x:Key="Canvas" Color="#171A2C"/>
    <SolidColorBrush x:Key="Surface" Color="#1F2340"/>
    <SolidColorBrush x:Key="Raised" Color="#282D50"/>
    <SolidColorBrush x:Key="Hover" Color="#30355C"/>
    <SolidColorBrush x:Key="Line" Color="#343960"/>
    <SolidColorBrush x:Key="Ink" Color="#F5F1FF"/>
    <SolidColorBrush x:Key="Soft" Color="#BDB7E0"/>
    <SolidColorBrush x:Key="Muted" Color="#9A94C4"/>
    <SolidColorBrush x:Key="Accent" Color="#C9BDFF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#1C1A33"/>
    <SolidColorBrush x:Key="Mint" Color="#A9F4D8"/>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Mint}" Margin="-3"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Width="42" Height="24">
              <Border x:Name="Track" CornerRadius="12" Background="{StaticResource Raised}"
                      BorderBrush="{StaticResource Line}" BorderThickness="1"/>
              <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0"
                       Fill="{StaticResource Soft}">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="Slide"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentInk}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><ExponentialEase Exponent="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><ExponentialEase Exponent="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Hover}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One option of a segmented choice -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Soft}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A colour dot -->
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="34" Height="34" Background="Transparent">
              <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
              <Ellipse Width="24" Height="24" Fill="{TemplateBinding Background}"
                       Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Line}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A picture choice: mascot shape or bubble style -->
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Foreground" Value="{StaticResource Soft}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel>
              <Border x:Name="Frame" Width="88" Height="76" CornerRadius="14" Background="{StaticResource Surface}"
                      BorderBrush="{StaticResource Line}" BorderThickness="1.5" Padding="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" HorizontalAlignment="Center"
                         Margin="0,6,0,0" FontSize="12"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Raised}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="10" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Soft}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- Thin scrollbar in the window's palette -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bar" CornerRadius="3" Background="{StaticResource Line}" Width="6"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{StaticResource Muted}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="370"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Live preview: the same view the desktop pet draws with -->
    <Border Grid.Column="0" Margin="20,20,8,16" CornerRadius="16" Background="{StaticResource Surface}"
            Padding="20,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Önizleme" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                     FontWeight="SemiBold"/>
          <TextBlock Text="Uygula’ya basınca masaüstündeki maskot böyle görünür." Foreground="{StaticResource Soft}"
                     TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="3" CornerRadius="10"
                Background="{StaticResource Canvas}" HorizontalAlignment="Left">
          <StackPanel x:Name="PreviewStates" Orientation="Horizontal"/>
        </Border>
        <Border x:Name="Stage" CornerRadius="12" Background="{StaticResource Canvas}" Margin="0,16,0,0"
                ClipToBounds="True">
          <local:PetView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,10"/>
        </Border>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,20,8,16" Focusable="False">
      <StackPanel x:Name="Sections" Margin="18,0,18,8"/>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Background="{StaticResource Surface}" Padding="20,12">
      <DockPanel>
        <Button x:Name="DefaultsButton" DockPanel.Dock="Left" Style="{StaticResource Quiet}"
                Content="Varsayılanlara dön" Click="Defaults"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Secondary}" Content="Kapat" Click="CloseClick" IsCancel="True"
                  Margin="0,0,10,0"/>
          <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Uygula" Click="ApplyClick"
                  IsDefault="True" MinWidth="104"/>
        </StackPanel>
        <TextBlock x:Name="Status" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"
                   Foreground="{StaticResource Soft}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
